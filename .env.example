# Mẫu cấu hình app cho Manual AI Novel.
# Sao chép file này thành .env rồi sửa; .env KHÔNG được commit và không chứa secret thật.
# Đây là app config. Cấu hình project truyện nằm trong projects/<ten-project>/project.json;
# không nhồi API key/endpoint vào project truyện.

# --- LLM ---
# true = dùng fake LLM offline (mặc định, không cần mạng, không tốn phí).
NOVEL_AI_USE_FAKE_LLM=true

# Chỉ có tác dụng khi NOVEL_AI_USE_FAKE_LLM=false.
NOVEL_AI_API_BASE_URL=https://your-provider.example/v1
NOVEL_AI_API_KEY=
NOVEL_AI_MODEL=your-model-name
NOVEL_AI_LLM_TIMEOUT_SECONDS=120
NOVEL_AI_LLM_TEMPERATURE=0.7
NOVEL_AI_LLM_MAX_TOKENS=4096
# Chỉ bật khi provider thật hỗ trợ response_format=json_schema.
NOVEL_AI_LLM_NATIVE_STRUCTURED_OUTPUT=false

# --- Đường dẫn ---
# Đường dẫn tương đối được tính từ repo root, không phụ thuộc current working directory.
NOVEL_AI_PROJECTS_ROOT=projects
NOVEL_AI_PROMPT_ROOT=docs/prompts/v1
